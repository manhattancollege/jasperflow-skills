{
  "schemaVersion": 1,
  "kind": "workflow",
  "name": "Equipment Request Approval",
  "description": "Routes example.jasperflow.json: the supervisor approves every request; anything over $500 also goes to Finance.",
  "definition": {
    "nodes": [
      { "id": "start", "type": "start", "label": "Submitted", "position": { "x": 260, "y": 40 } },
      {
        "id": "supervisor", "type": "approval", "label": "Supervisor",
        "assignment": { "mode": "banner_supervisor", "fallback": { "mode": "static_role", "role": "WORKFLOW_ADMIN" } },
        "dueInHours": 72,
        "position": { "x": 260, "y": 160 }
      },
      {
        "id": "over_500", "type": "condition", "label": "Over $500?",
        "condition": { "fieldId": "estimated_cost", "operator": "gt", "value": 500 },
        "position": { "x": 260, "y": 280 }
      },
      {
        "id": "finance", "type": "approval", "label": "Finance",
        "assignment": { "mode": "group", "groupName": "Finance" },
        "position": { "x": 60, "y": 400 }
      },
      { "id": "approved", "type": "end", "label": "Approved", "end": { "outcome": "approved", "notifySubmitter": true }, "position": { "x": 260, "y": 520 } },
      { "id": "declined", "type": "end", "label": "Declined", "end": { "outcome": "rejected", "notifySubmitter": true }, "position": { "x": 500, "y": 400 } }
    ],
    "edges": [
      { "id": "e_start", "source": "start", "target": "supervisor", "branch": "default" },
      { "id": "e_sup_ok", "source": "supervisor", "target": "over_500", "branch": "default" },
      { "id": "e_sup_no", "source": "supervisor", "target": "declined", "branch": "reject" },
      { "id": "e_big", "source": "over_500", "target": "finance", "branch": "true" },
      { "id": "e_small", "source": "over_500", "target": "approved", "branch": "false" },
      { "id": "e_fin_ok", "source": "finance", "target": "approved", "branch": "default" },
      { "id": "e_fin_no", "source": "finance", "target": "declined", "branch": "reject" }
    ],
    "settings": {}
  }
}
